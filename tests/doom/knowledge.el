;;; knowledge.el -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'org-capture)
(require 'org-agenda)
(require 'org-roam)
(require 'org-roam-dailies)

(defun kit/test-file-text (file)
  (with-temp-buffer (insert-file-contents file) (buffer-string)))

(let ((inbox (expand-file-name "inbox.org" org-directory))
      (other (expand-file-name "other-notes" (getenv "HOME"))))
  (write-region "Preserve this existing note\n" nil inbox nil 'silent)
  (kit/org-ensure-layout)
  (cl-assert (equal (kit/test-file-text inbox) "Preserve this existing note\n"))
  (let ((org-directory other)) (kit/org-ensure-layout))
  (cl-assert (file-exists-p (expand-file-name "agenda/tasks.org" other)))
  (cl-assert (equal (kit/test-file-text (expand-file-name "inbox.org" other)) "")))

(defun kit/test-capture (key text)
  (org-capture nil key)
  (let ((buffer (seq-find (lambda (b) (buffer-local-value 'org-capture-mode b))
                          (buffer-list))))
    (cl-assert buffer)
    (with-current-buffer buffer
      (let ((file (buffer-file-name (or (buffer-base-buffer) (current-buffer)))))
        (insert text)
        (org-capture-finalize)
        file))))

(kit/test-capture "i" "Inbox smoke")
(kit/test-capture "t" "Task smoke")
(kit/test-capture "m" "Meeting smoke")
(let ((concept-file (kit/test-capture "c" "Concept smoke"))
      (investigation-file (kit/test-capture "e" "Investigation smoke")))
  (org-roam-db-sync)
  (let* ((concept (org-roam-node-from-title-or-alias "Concept smoke"))
         (investigation (org-roam-node-from-title-or-alias "Investigation smoke"))
         (id (org-roam-node-id concept)))
    (cl-assert concept)
    (cl-assert investigation)
    (cl-assert (equal (file-truename concept-file) (file-truename (org-roam-node-file concept))))
    (with-current-buffer (find-file-noselect investigation-file)
      (goto-char (point-max))
      (insert (format "\n[[id:%s][Concept smoke]]\n" id))
      (save-buffer))
    (org-roam-db-sync)
    (cl-assert (equal id (org-roam-node-id (org-roam-node-from-title-or-alias "Concept smoke"))))
    (cl-assert (seq-some
                (lambda (link) (equal (org-roam-node-id (org-roam-backlink-source-node link))
                                      (org-roam-node-id investigation)))
                (org-roam-backlinks-get concept)))
    (org-roam-buffer-toggle)
    (cl-assert (get-buffer org-roam-buffer))))

(cl-assert (string-match-p "Inbox smoke" (kit/test-file-text (expand-file-name "inbox.org" org-directory))))
(cl-assert (string-match-p "Meeting smoke" (kit/test-file-text (expand-file-name "journal/meetings.org" org-directory))))
(org-todo-list)
(with-current-buffer org-agenda-buffer-name
  (cl-assert (string-match-p "TODO Task smoke" (buffer-string))))

(org-roam-dailies-goto-today)
(let ((daily (expand-file-name (format-time-string "journal/%Y-%m-%d.org") org-directory)))
  (cl-assert (get-file-buffer daily) nil "Daily note missing; open files: %S (roam=%S daily=%S)"
             (delq nil (mapcar #'buffer-file-name (buffer-list))) org-roam-directory org-roam-dailies-directory)
  (with-current-buffer (find-file-noselect daily)
    (goto-char (point-max))
    (insert "\nDaily sentinel\n")
    (save-buffer))
  (cl-assert (file-exists-p daily))
  (org-roam-dailies-goto-today)
  (cl-assert (string-match-p "Daily sentinel" (kit/test-file-text daily))))

(let* ((untrusted (expand-file-name "untrusted.org" (getenv "HOME")))
       (effect (expand-file-name "executed-untrusted-code" (getenv "HOME"))))
  (with-temp-file untrusted
    (insert (format "#+begin_src emacs-lisp\n(write-region \"owned\" nil %S)\n#+end_src\n" effect)))
  (find-file-noselect untrusted)
  (cl-assert (not (file-exists-p effect)))
  (cl-assert org-confirm-babel-evaluate))
(cl-assert (not (string-prefix-p "/nix/store/" org-roam-db-location)))
(cl-assert (file-exists-p org-roam-db-location))
t
