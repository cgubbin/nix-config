+local function cargo_metadata(cwd)
+    if vim.in_fast_event() then require("nio").scheduler() end
+    local job = Job:new({
+        command = "direnv",
+        args = { "exec", cwd, "cargo", "metadata", "--no-deps" },
+        cwd = cwd,
+    })
+    local result = job:sync()
+    if job.code ~= 0 then
+        error("cargo metadata failed in project environment: " .. table.concat(job:stderr_result(), "\n"))
+    end
+    return vim.json.decode(table.concat(result, "\n"))
+end
 
